<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sabores Libres – Reserva</title>

    <!-- LINK A TU CSS -->
    <link rel="stylesheet" href="css/style.css">

    <!-- Tipografía secundaria desde Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Slab:wght@300;400;600&display=swap" rel="stylesheet">
</head>

<body>

    <!-- ==============================
         HEADER + MENU
    =============================== -->
    <header>
        <nav>
            <ul>
                <li><a href="#">INICIO</a></li>
                <li><a href="#">MENÚ</a></li>
                <li><a href="#">PROMOCIÓN</a></li>
                <li><a href="#">DELIVERY</a></li>
                <li><a href="#">RESERVA</a></li>
            </ul>
        </nav>
    </header>


    <!-- ==============================
         FORMULARIO DE RESERVA
    =============================== -->
    <section class="reserva-container">

        <h2>Hacé tu Reserva</h2>

        <p>
            “Reservá tu mesa en Sabores Libres y descubrí el verdadero placer de comer sin preocupaciones.”
            <br><br>
            <strong>Cena</strong> para <strong>2 personas</strong> el 
            <strong>Sábado 4 de Octubre 20:30hs.</strong>
        </p>

        <div>
            <label>Nombre completo:</label><br>
            <input type="text" placeholder="Tu nombre">
        </div>

        <div>
            <label>Teléfono de contacto:</label><br>
            <input type="tel" placeholder="Tu número">
        </div>

        <div style="margin-top: 2rem; display:flex; justify-content:space-between; max-width:450px; margin-inline:auto;">
            <button class="btn">VOLVER</button>
            <button class="btn">SIGUIENTE</button>
        </div>

    </section>


    <!-- ==============================
         TIENDA – CARDS
    =============================== -->
    <section class="tienda-wrapper">

        <!-- Flecha izquierda -->
        <div class="arrow">⟵</div>

        <!-- Producto 1 -->
        <div class="card">
            <img src="img/producto1.jpg" alt="Producto 1">
            <h4>Lorem ipsum</h4>
            <p>$1000</p>
        </div>

        <!-- Producto 2 -->
        <div class="card">
            <img src="img/producto2.jpg" alt="Producto 2">
            <h4>Lorem ipsum</h4>
            <p>$1000</p>
        </div>

        <!-- Producto 3 -->
        <div class="card">
            <img src="img/producto3.jpg" alt="Producto 3">
            <h4>Lorem ipsum</h4>
            <p>$1000</p>
        </div>

        <!-- Producto 4 -->
        <div class="card">
            <img src="img/producto4.jpg" alt="Producto 4">
            <h4>Lorem ipsum</h4>
            <p>$1000</p>
        </div>

        <!-- Flecha derecha -->
        <div class="arrow">⟶</div>

    </section>


    <!-- ==============================
         BARRA DE NOVEDADES
    =============================== -->
    <div class="news-bar">Enterate de todas nuestras novedades</div>


    <!-- ==============================
         FOOTER
    =============================== -->
    <footer>

        <!-- Logo -->
        <div>
            <img class="logo-footer" src="img/logo-sabores.png" alt="Logo Sabores Libres">
        </div>

        <!-- Menú -->
        <div>
            <p><strong>¿Quiénes Somos?</strong></p>
            <p>Cargá tu CV</p>
            <p>Menú</p>
            <p>Promociones</p>
        </div>

        <!-- Información -->
        <div>
            <p><strong>TIENDA</strong></p>
            <p>Delivery</p>
            <p>Reservas: +54 341 5111111</p>
        </div>

        <!-- Horarios + Ubicación -->
        <div>
            <p><strong>HORARIO</strong><br>Lunes a Domingo de 8 a 23hs</p>
            <p><strong>UBICACIÓN</strong><br>Corrientes 5677, Rosario</p>
        </div>

        <!-- Redes -->
        <div class="social">
            <span>🅕</span>
            <span>✕</span>
            <span>📷</span>
        </div>

    </footer>


    <!-- ==============================
         BOTÓN WHATSAPP
    =============================== -->
    <div class="whatsapp-btn">
        <img src="img/whatsapp.svg" alt="WhatsApp" width="36">
    </div>

</body>
</html>

